#!/usr/bin/env sh
#
# The rebase half of the same fix post-merge covers — see that file. `git
# rebase` doesn't fire post-merge, but it does fire post-rewrite with $1
# "rebase" once the whole rebase has finished and the working tree is in its
# final state, which is exactly when regenerating is safe to do. Intermediate
# commits mid-rebase are not touched: only the tip matters here, since this
# repository squash-merges PRs and a rewritten-but-uncommitted file is picked
# up by the next commit either way.
#
# Two things happen here:
#
# 1. C# formatting. A rebase commits without running pre-commit — neither a
#    replayed pick nor the commit `git rebase --continue` makes after a
#    conflict is resolved — so a file written while resolving one (a
#    regenerated migration, say) reaches the branch unformatted and fails CI's
#    `dotnet format --verify-no-changes`. Every .cs or .csproj file the
#    rewritten commits touched is formatted now, and staged if that changed it.
#    stdin carries one "<old-sha> <new-sha>" line per rewritten commit.
# 2. .spec/claims.json, .spec/traceability.md, and .spec/README.md are
#    regenerated and staged if they changed, and the specification is merged
#    into the local graphify graph.
#
# A dev-machine convenience, not a CI gate — see .githooks/post-merge. This
# file is the tracked hook, run by the shim ./init-dev.sh installs
# (tools/dev/git-hook-shim.sh) — edit this file, not the installed one.

set -u

[ "${1-}" = "rebase" ] || exit 0

HOOK_DIR=$(cd "$(dirname "$0")" && pwd) || exit 0
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 0

# shellcheck source=.githooks/lib/regenerate-spec.sh
. "$HOOK_DIR/lib/regenerate-spec.sh"

# The primary checkout's main only ever fast-forwards to origin/main, which
# already carries the claims, matrix, and index CI regenerated and checked
# (ADR-0101). Nothing is regenerated or staged there: a hook must never leave a
# change on main (#802).
if [ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "main" ]; then
	merge_spec_graph
	exit 0
fi

REWRITTEN_CS=$(
	while read -r _old new _rest; do
		git diff-tree --no-commit-id --name-only -r "$new"
	done | grep -E '\.(cs|csproj)$' | sort -u
)

if [ -n "$REWRITTEN_CS" ] && command -v dotnet >/dev/null 2>&1; then
	EXISTING_CS=$(echo "$REWRITTEN_CS" | while IFS= read -r f; do [ -f "$f" ] && echo "$f"; done)

	if [ -n "$EXISTING_CS" ]; then
		# shellcheck disable=SC2086 # word-split on purpose: one path per --include arg
		dotnet format HpacSafety.slnx --include $EXISTING_CS >/dev/null 2>&1

		# shellcheck disable=SC2086
		if ! git diff --quiet -- $EXISTING_CS; then
			# shellcheck disable=SC2086
			git add -- $EXISTING_CS
			echo "post-rewrite: dotnet format fixed C# files the rebase wrote and staged them — include them in your next commit."
		fi
	fi
fi

regenerate_spec post-rewrite

exit 0
