<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" />
        <PackageReference Include="coverlet.collector" />
        <PackageReference Include="Magick.NET-Q8-AnyCPU" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Npgsql" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Testcontainers.Minio" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <None CopyToOutputDirectory="PreserveNewest" Include="Media/fixtures/**" />
    </ItemGroup>

    <!-- The one committed binary fixture. HEIC cannot be generated at run time:
         the imaging library decodes it but cannot encode it. See
         Media/fixtures/README.md. -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\HpacSafety.Infrastructure\HpacSafety.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None CopyToOutputDirectory="PreserveNewest" Include="..\..\docs\form-spec.md" Link="form-spec.md" />
    </ItemGroup>

    <!-- The seed test reads the generated form specification and asserts the
         seeded question bank reproduces every field in it. See ADR-0020. -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
