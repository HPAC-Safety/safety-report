<Project Sdk="Microsoft.NET.Sdk.Worker">

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <!-- Deployed, the Worker is a Lambda function invoked directly (not
             through the Web Adapter the API uses) — one drain per invocation,
             then return (ADR-0123). Program.cs only reaches this path when
             AWS_LAMBDA_RUNTIME_API is set; everywhere else it is unused. -->
        <PackageReference Include="Amazon.Lambda.Core" />
        <PackageReference Include="Amazon.Lambda.RuntimeSupport" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HpacSafety.Core\HpacSafety.Core.csproj" />
        <ProjectReference Include="..\HpacSafety.Infrastructure\HpacSafety.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Prompts\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup>
        <UserSecretsId>dotnet-HpacSafety.Worker-491eec12-f207-44d6-8f55-4f750d827303</UserSecretsId>
    </PropertyGroup>
</Project>
