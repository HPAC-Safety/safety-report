{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // `options` opts this database in to the seeded local administrator,
    // admin@localhost. Production never sets it, so production never gets one.
    // See ADR-0020.
    "HpacSafety": "Host=localhost;Port=5432;Database=hpac_safety;Username=postgres;Password=postgres;Options=-c hpac.seed_development_admin=true"
  },
  "HpacSafety": {
    "FieldEncryption": {
      // A throwaway development key, committed on purpose so a clean checkout
      // runs. It decodes to the ASCII string "hpac-safety-development-key-only",
      // which is the point: nothing encrypted with it is protected, and no real
      // report is ever written under it. Production resolves this from Secrets
      // Manager. See ADR-0019.
      "Key": "aHBhYy1zYWZldHktZGV2ZWxvcG1lbnQta2V5LW9ubHk="
    }
  }
}
