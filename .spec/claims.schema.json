{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/HPAC-Safety/safety-report/.spec/claims.schema.json",
	"title": "Specification claims",
	"description": "The shape of .spec/claims.json, generated by tools/spec/generate-traceability.ts (ADR-0193): every claim with its scenario, steps, and bindings; every constraint; every decision and lesson with what it cites; and the step definitions that are ambiguous or unused.",
	"type": "object",
	"required": ["claims", "constraints", "decisions", "lessons", "ambiguousSteps", "unusedStepDefinitions"],
	"additionalProperties": false,
	"properties": {
		"claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
		"constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
		"decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
		"lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } },
		"ambiguousSteps": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["step", "files"],
				"additionalProperties": false,
				"properties": {
					"step": { "type": "string", "minLength": 1 },
					"files": { "$ref": "#/$defs/files" }
				}
			}
		},
		"unusedStepDefinitions": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["engine", "keyword", "pattern", "file"],
				"additionalProperties": false,
				"properties": {
					"engine": { "$ref": "#/$defs/engine" },
					"keyword": { "enum": ["Given", "When", "Then"] },
					"pattern": { "type": "string" },
					"file": { "type": "string", "minLength": 1 }
				}
			}
		}
	},
	"$defs": {
		"claimId": { "type": "string", "pattern": "^REQ-[A-Z]+-\\d{3}$" },
		"constraintId": { "type": "string", "pattern": "^CON-[A-Z]+-\\d{3}$" },
		"decisionId": { "type": "string", "pattern": "^ADR-\\d{4}$" },
		"lessonId": { "type": "string", "pattern": "^\\d{4}$" },
		"engine": { "enum": ["Reqnroll", "playwright-bdd"] },
		"files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
		"claimIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/claimId" } },
		"constraintIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/constraintId" } },
		"decisionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/decisionId" } },
		"claim": {
			"type": "object",
			"required": ["id", "area", "file", "title", "rule", "tags", "engine", "status", "steps", "stepFiles", "staleIgnore", "constraints", "citedBy"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/claimId" },
				"area": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
				"file": { "type": "string", "pattern": "^\\.spec/features/.+\\.feature$" },
				"title": { "type": "string", "minLength": 1 },
				"rule": { "type": ["string", "null"] },
				"tags": { "type": "array", "items": { "type": "string", "pattern": "^@" } },
				"engine": { "$ref": "#/$defs/engine" },
				"status": { "enum": ["Covered", "Planned"] },
				"steps": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["keyword", "text", "files", "ambiguous"],
						"additionalProperties": false,
						"properties": {
							"keyword": { "enum": ["Given", "When", "Then"] },
							"text": { "type": "string", "minLength": 1 },
							"files": { "$ref": "#/$defs/files" },
							"ambiguous": { "type": "boolean" }
						}
					}
				},
				"stepFiles": { "$ref": "#/$defs/files" },
				"staleIgnore": { "type": "boolean" },
				"constraints": { "$ref": "#/$defs/constraintIds" },
				"citedBy": {
					"type": "object",
					"required": ["decisions", "lessons"],
					"additionalProperties": false,
					"properties": {
						"decisions": { "$ref": "#/$defs/decisionIds" },
						"lessons": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/lessonId" } }
					}
				}
			}
		},
		"constraint": {
			"type": "object",
			"required": ["id", "page", "verifiedBy", "note"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/constraintId" },
				"page": { "type": "string", "pattern": "^\\.spec/.+\\.md$" },
				"verifiedBy": { "$ref": "#/$defs/claimIds" },
				"note": { "type": "string", "minLength": 1 }
			}
		},
		"decision": {
			"type": "object",
			"required": ["id", "file", "title", "status", "claims", "constraints", "decisions", "supersedes", "amends"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/decisionId" },
				"file": { "type": "string", "pattern": "^\\.spec/decisions/ADR-\\d{4}-.+\\.md$" },
				"title": { "type": "string" },
				"status": { "type": "string" },
				"claims": { "$ref": "#/$defs/claimIds" },
				"constraints": { "$ref": "#/$defs/constraintIds" },
				"decisions": { "$ref": "#/$defs/decisionIds" },
				"supersedes": { "$ref": "#/$defs/decisionIds" },
				"amends": { "$ref": "#/$defs/decisionIds" }
			}
		},
		"lesson": {
			"type": "object",
			"required": ["id", "file", "title", "status", "claims", "constraints", "decisions", "skills"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/lessonId" },
				"file": { "type": "string", "pattern": "^\\.spec/lessons/\\d{4}-.+\\.md$" },
				"title": { "type": "string" },
				"status": { "type": "string" },
				"claims": { "$ref": "#/$defs/claimIds" },
				"constraints": { "$ref": "#/$defs/constraintIds" },
				"decisions": { "$ref": "#/$defs/decisionIds" },
				"skills": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$" } }
			}
		}
	}
}
