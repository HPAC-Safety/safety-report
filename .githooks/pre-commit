#!/usr/bin/env sh
#
# Three genuinely independent checks, each gated on the kind of file actually
# staged so an unrelated commit pays nothing. This file is the tracked
# template; ./init-dev.sh copies it into the real hooks directory (see that
# file for why it's a copy rather than core.hooksPath) — edit this copy, not
# the installed one, and re-run ./init-dev.sh to pick up the change.
#
# "Independent" is load-bearing and was not true before: `set -e` let a locale
# failure abort the script before `dotnet format` ran, so a commit refused for
# a missing French key also silently skipped its formatting. Every check now
# runs, and the hook fails at the end if any of them did.
#
# 1. locales/en-CA.json and locales/fr-CA.json parity: a missing/extra key, an
#    English `#`-stub, stale fr-CA.meta.json provenance, or a glossary
#    mismatch. Before checking, tools/stub-missing-translations.mjs (ADR-0054)
#    runs first and re-stages the result: a key added to one language and not
#    the other is filled into the missing side with a `#`-prefixed copy of the
#    text it has, both directions, so a bare "add a key" commit never blocks
#    on parity by itself — it only blocks on a stub CI still has to resolve.
#    Then this runs the exact same checks as the "i18n" CI job
#    (tools/check-locales.mjs, tools/translate-locale.mjs --check) but
#    locally, before the commit exists, instead of after a push.
#
#    Two exceptions, on a branch only, both reported and allowed through: a
#    FRENCH value still carrying its local `#` stub, and an ENGLISH value
#    edited after it was translated (a stale fr-CA.meta.json source_hash).
#    Both are pending work a workflow resolves rather than something the
#    author can fix locally — translate-locale.mjs --generate queues a stale
#    hash for re-translation exactly as it queues a missing key. ADR-0057 has
#    i18n-translate.yml commit the French straight onto a same-repo pull
#    request's branch, so the stub is a known, temporary state that a workflow
#    resolves — and with no DeepL credential locally there is nothing a
#    developer could do to satisfy the old rule except `--no-verify`, which
#    also skipped the formatting check for a reason that had nothing to do
#    with formatting. On main the stub is still fatal, and CI never passes
#    --allow-pending-translation, so one still cannot reach main. An ENGLISH
#    stub is fatal everywhere — no workflow ever writes English — so adding a
#    key in French only still requires you to write the real English by hand.
#
# 2. Markdown frontmatter: every tracked .md/.mdc declares its title,
#    description, and type (ADR-0087). Only the staged markdown is checked,
#    and the Worker's runtime prompts are exempt because their bytes are the
#    model payload. CI's "docs" job re-checks the whole tree as a backstop for
#    anyone who skipped this hook — but a rule that lives only in CI is not a
#    rule (ADR-0073), which is why it is here first.
#    When a skill or agent is staged, the generic ones are also checked for
#    anything that names this repository (ADR-0131).
#
# 3. C# formatting: dotnet format --include <staged files>, auto-fixing and
#    re-staging just those files, so formatting drift never reaches a commit
#    without touching files outside the diff. CI's "build" job re-verifies
#    the whole solution with --verify-no-changes as a server-side backstop
#    for anyone who skipped this hook.

set -u

REPO_ROOT=$(git rev-parse --show-toplevel)

# `set -e` is deliberately not used — it is what made the two checks
# dependent — so this cd guards itself.
cd "$REPO_ROOT" || exit 1

status=0

staged() {
	git diff --cached --name-only --diff-filter=ACMR
}

# A detached HEAD is not main, and is not somewhere a translation lands
# either; treat it like a branch rather than refusing to commit at all.
branch=$(git symbolic-ref --quiet --short HEAD || echo "")

if [ "$branch" = "main" ]; then
	pending_translation_flag=""
else
	pending_translation_flag="--allow-pending-translation"
fi

if staged | grep -q '^locales/'; then
	if ! command -v node >/dev/null 2>&1; then
		echo "pre-commit: node is not on PATH, cannot verify locales/ — see README.md" >&2
		status=1
	else
		# Which locale files the developer actually put in this commit,
		# captured before the stubber rewrites anything.
		STAGED_LOCALES=$(staged | grep '^locales/' || true)

		node tools/stub-missing-translations.mjs --locales locales

		# fr-CA.json is generated and never hand-authored (ADR-0021,
		# ADR-0056), so staging it is safe — and it is what makes the commit
		# self-consistent: a new English key and its French placeholder land
		# together rather than one without the other.
		[ -f locales/fr-CA.json ] && git add -- locales/fr-CA.json

		# en-CA.json is hand-authored, so it is re-staged only if it was
		# already staged. The stubber rewrites a whole file from the working
		# tree, so adding it unconditionally would sweep in unstaged edits the
		# developer deliberately left out of this commit — the same trap the
		# formatting block below avoids by re-adding only what it formatted.
		#
		# The stubber touches en-CA.json only for a key that exists in French
		# and not English, and the `#` stub that produces is fatal everywhere:
		# no workflow writes English, so that one is always fixed by hand.
		if echo "$STAGED_LOCALES" | grep -q '^locales/en-CA\.json$'; then
			git add -- locales/en-CA.json
		fi

		node tools/check-locales.mjs || status=1

		# shellcheck disable=SC2086 # empty on main, one flag elsewhere
		node tools/translate-locale.mjs --check --locales locales $pending_translation_flag || status=1
	fi
fi

if staged | grep -qE '\.(md|mdc)$'; then
	if ! command -v node >/dev/null 2>&1; then
		echo "pre-commit: node is not on PATH, cannot verify markdown frontmatter — see README.md" >&2
		status=1
	else
		STAGED_MARKDOWN=$(staged | grep -E '\.(md|mdc)$')

		# shellcheck disable=SC2086 # word-split on purpose: one path per argument
		node tools/check-frontmatter.mjs $STAGED_MARKDOWN || status=1

		# A generic skill or role agent names nothing specific to this
		# repository, so it can be reused elsewhere (ADR-0131).
		if echo "$STAGED_MARKDOWN" | grep -qE '^(skills|agents)/'; then
			node tools/check-generic-instructions.mjs || status=1
		fi

		# A decision record's number is claimed by naming a file, and two
		# branches claim the same one often enough that it is worth catching
		# here rather than after a rebase (ADR-0091, lesson 0003).
		if echo "$STAGED_MARKDOWN" | grep -q '^docs/decisions/ADR-'; then
			node tools/adr-numbers.mjs || status=1
		fi
	fi
fi

if staged | grep -qE '\.(cs|csproj)$'; then
	if ! command -v dotnet >/dev/null 2>&1; then
		echo "pre-commit: dotnet is not on PATH, cannot run dotnet format — see README.md" >&2
		status=1
	else
		STAGED_CS=$(staged | grep -E '\.(cs|csproj)$')

		# --include scopes formatting to the staged files, not the whole
		# solution, so a commit touching two files never rewrites (and
		# re-stages) unrelated ones elsewhere in the tree that also happen to
		# be out of format.
		# shellcheck disable=SC2086 # word-split on purpose: one path per --include arg
		if dotnet format HpacSafety.slnx --include $STAGED_CS; then
			echo "$STAGED_CS" | while IFS= read -r f; do
				[ -f "$f" ] && git add -- "$f"
			done
		else
			status=1
		fi
	fi
fi

exit "$status"
