#!/usr/bin/env sh
#
# The pre-commit runner. Each check is its own file under pre-commit.d/,
# NN-<check>.sh, run in lexical order with `sh`; each one gates itself on the
# staged files it cares about and says what it guards (CONV-005). A new check
# is a new file there, not a block here.
#
# Every check runs, and the commit is refused at the end if any failed: one
# failing check must never skip another (the `set -e` bug, #207).

set -u

HOOK_DIR=$(cd "$(dirname "$0")" && pwd) || exit 1
REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO_ROOT" || exit 1

# Added, copied, modified, or renamed staged paths, one per line, read once. A
# check that needs another --diff-filter asks git itself.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# Main is strict where a branch is not. A detached HEAD counts as a branch.
BRANCH=$(git symbolic-ref --quiet --short HEAD || echo "")

export STAGED BRANCH

status=0
for check in "$HOOK_DIR"/pre-commit.d/*.sh; do
	[ -f "$check" ] || continue
	if ! sh "$check"; then
		echo "pre-commit: $(basename "$check") failed" >&2
		status=1
	fi
done

exit "$status"
