{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["eslint.config.mjs", "tools/**/*.mjs", "tests/js/**/*.mjs"]
}
