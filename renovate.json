{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"configMigration": true,
	"extends": [
		"config:recommended"
	],
	"ignorePresets": [
		":disableRateLimiting"
	],
	"timezone": "America/Edmonton",
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": [
			"* 0-6 * * 1"
		]
	},
	"prConcurrentLimit": 0,
	"prHourlyLimit": 0,
	"automergeStrategy": "squash",
	"platformAutomerge": true,
	"labels": [
		"dependencies",
		"renovate"
	],
	"prBodyNotes": [
		"## Checklist",
		"",
		"- [x] This PR resolves the linked issue",
		"- [ ] Tests have been added or updated",
		"- [x] Rebased on top of main"
	],
	"vulnerabilityAlerts": {
		"addLabels": [
			"area:security"
		],
		"schedule": [
			"at any time"
		],
		"prPriority": 10
	},
	"packageRules": [
		{
			"description": "Label major updates as breaking changes",
			"matchUpdateTypes": [
				"major"
			],
			"addLabels": [
				"breaking-change"
			],
			"prBodyNotes": [
				"- [x] This is a breaking change"
			]
		},
		{
			"description": "Approve non-major updates but do not automerge yet. platformAutomerge holds a PR until the REQUIRED status checks pass, and the ruleset that makes them required is applied by hand after the CI pull request merges. Turning automerge on in the same commit as CI would leave a window in which a Renovate PR has nothing to wait for. Flipped to true in a follow-up, after the ruleset is applied - see ADR-0011.",
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"autoApprove": true,
			"automerge": false,
			"prBodyNotes": [
				"- [ ] This is a breaking change"
			]
		},
		{
			"description": "Skip pinned versions",
			"matchManagers": [
				"nuget"
			],
			"matchCurrentValue": "/^\\[[^,]+\\]$/",
			"enabled": false
		},
		{
			"description": "The .NET SDK in global.json is pinned deliberately; never automerge it",
			"matchManagers": [
				"dotnet-sdk"
			],
			"groupName": ".NET SDK",
			"automerge": false
		},
		{
			"groupName": "Analyzers",
			"matchPackageNames": [
				"Microsoft.CodeAnalysis.BannedApiAnalyzers",
				"Roslynator.Analyzers"
			]
		},
		{
			"description": "The coverage toolchain, matching its ItemGroup in Directory.Packages.props. reportgenerator lives in .config/dotnet-tools.json but belongs with the collector it consumes.",
			"groupName": "Coverage",
			"matchPackageNames": [
				"coverlet.collector",
				"dotnet-reportgenerator-globaltool"
			]
		},
		{
			"groupName": "Anthropic",
			"matchPackageNames": [
				"/^Anthropic/"
			]
		},
		{
			"groupName": "AWSSDK",
			"matchPackageNames": [
				"/^AWSSDK/"
			]
		},
		{
			"groupName": "FakeItEasy",
			"matchPackageNames": [
				"/^FakeItEasy/"
			]
		},
		{
			"groupName": "GitHub Actions",
			"matchManagers": [
				"github-actions"
			]
		},
		{
			"groupName": "Microsoft and System",
			"matchPackageNames": [
				"/^Microsoft\\./",
				"/^System\\./",
				"!/^Microsoft\\.EntityFrameworkCore/",
				"!/^Microsoft\\.CodeAnalysis/"
			]
		},
		{
			"description": "EF Core and the Npgsql PROVIDER must move together or migrations break. The bare Npgsql driver is a different vendor on its own cadence and is grouped separately.",
			"groupName": "EntityFrameworkCore",
			"matchPackageNames": [
				"/^Microsoft\\.EntityFrameworkCore/",
				"/^Npgsql\\.EntityFrameworkCore/"
			]
		},
		{
			"description": "The bare Npgsql driver, matching its ItemGroup in Directory.Packages.props. Excludes the EF Core provider, which is pinned to EF Core's cadence above.",
			"groupName": "Npgsql",
			"matchPackageNames": [
				"/^Npgsql/",
				"!/^Npgsql\\.EntityFrameworkCore/"
			]
		},
		{
			"groupName": "Shouldly",
			"matchPackageNames": [
				"/^Shouldly/"
			]
		},
		{
			"groupName": "Testcontainers",
			"matchPackageNames": [
				"/^Testcontainers/"
			]
		},
		{
			"groupName": "xunit",
			"matchPackageNames": [
				"/^xunit/"
			]
		},
		{
			"description": "Keep Renovate up to date (self-managed)",
			"groupName": "Renovate",
			"matchManagers": [
				"npm"
			],
			"matchPackageNames": [
				"renovate"
			],
			"automerge": true
		}
	]
}
