{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Supplied per environment. Empty here so that nothing ever falls back to
    // a database somebody did not mean to write to.
    "HpacSafety": ""
  },
  "HpacSafety": {
    "FieldEncryption": {
      // Report values are encrypted by the application before PostgreSQL
      // sees them. The key is a base64 256-bit value, supplied per environment:
      // a throwaway literal in appsettings.Development.json, a Secrets Manager
      // reference in production. Never committed with a real value.
      // See ADR-0019.
      "Key": ""
    },
    "Media": {
      // Applied independently to every accepted attachment format, and to how
      // many one report may carry. See issue #14.
      "Policy": {
        "MaxByteSize": 52428800,
        "MaxAttachmentCount": 5
      },
      // The private bucket. Supplied per environment; empty here so nothing
      // ever falls back to a bucket nobody meant to write to. ServiceUrl stays
      // empty in AWS, where the SDK reaches S3 as the ECS task role; only
      // development points it at MinIO (ADR-0096).
      "Storage": {
        "S3": {
          "BucketName": "",
          "ServiceUrl": "",
          "PublicServiceUrl": ""
        }
      }
    },
    "RateLimiting": {
      // A burst allowance, not a hard cap on legitimate use: a reporter's one
      // report submission is one request; a member fixing a typo tries
      // sign-in more than once. See ADR-0081 and issue #15.
      "PublicSubmission": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      // Each attached file is one upload, and a cancel or remove is another
      // request, so one report legitimately makes a dozen or so. See ADR-0096.
      "AttachmentUpload": {
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      // Deliberately stricter: nobody legitimately attempts many different
      // sign-ins from one identity in a short window, and this endpoint
      // makes a real call to the live members site per attempt (ADR-0079).
      "SignIn": {
        "PermitLimit": 5,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    }
  }
}
