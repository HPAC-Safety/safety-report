{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Translation": {
    // Machine translation between en-CA and fr-CA (ADR-0179). It uses the
    // AiChatClient key below, so there is no key here; only its own model and
    // reasoning level, tuned apart from summaries. The model name picks the
    // provider ("gemini-" is Gemini). A blank model or a level other than
    // low/medium/high stops startup, and so does a model no provider claims
    // when a key is held (REQ-WLD-040, REQ-WLD-043).
    "Model": "gemini-3.7-flash",
    "ReasoningEffort": "low"
  },
  "ConnectionStrings": {
    // Supplied per environment. Empty here so that nothing ever falls back to
    // a database somebody did not mean to write to.
    "HpacSafety": ""
  },
  "AiChatClient": {
    // The one summarization call's key, model, and reasoning level, kept
    // together (ADR-0104). There is no provider setting: the model name picks
    // the IAiMediator handler by its prefix ("gemini-" is the only one
    // today; another OpenAI-compatible provider is a new IAiHandler class plus
    // one registration line). A blank model, a model no handler claims,
    // or a reasoning level other than low/medium/high stops the Worker at
    // startup whenever a key is present.
    // A paid, billing-enabled key only — the free tier may use submitted
    // content. Never committed. In every deployed environment the Worker
    // reads it itself from Secrets Manager by the ARN Terraform sets as
    // AiChatClient__ApiKeySecretArn (infra/lambda.tf); locally it is the
    // plain AiChatClient__ApiKey environment variable, exported as
    // GEMINI_API_KEY for docker-compose. With no key, summarization fails
    // closed. Translation (ADR-0179) uses this same key, with its own Translation:Model.
    "ApiKey": "",
    "Model": "gemini-3.7-flash",
    // low | medium | high. Low is enough: the marking pass replaces exact
    // private values before the call, and the prompt carries every
    // replacement rule. Raise it to medium if reviewers find paraphrased
    // identities getting through. The temperature is deliberately not set.
    "ReasoningEffort": "low"
  },
  "HpacSafety": {
    "FieldEncryption": {
      // Report values are encrypted by the application before PostgreSQL
      // sees them. The key is a base64 256-bit value, supplied per environment:
      // a throwaway literal in appsettings.Development.json, a Secrets Manager
      // reference in production. Never committed with a real value.
      // See ADR-0019.
      "Key": ""
    }
  }
}
