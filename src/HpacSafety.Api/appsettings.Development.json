{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "HpacSafety": "Host=localhost;Port=5432;Database=hpac_safety;Username=postgres;Password=postgres"
  },
  "HpacSafety": {
    // Signs the tokens this host issues and then validates. A throwaway for
    // local use only: the endpoint that issues them is mapped only in
    // Development, so this key reaches no deployed environment. Production
    // validates against its provider's published keys and holds no signing key
    // of its own. See ADR-0066.
    "Authentication": {
      "DevelopmentSigningKey": "hpac-safety-development-signing-key-not-a-secret"
    },
    "FieldEncryption": {
      // A throwaway development key, committed on purpose so a clean checkout
      // runs. It decodes to the ASCII string "hpac-safety-development-key-only",
      // which is the point: nothing encrypted with it is protected, and no real
      // report is ever written under it. Production resolves this from Secrets
      // Manager. See ADR-0019.
      "Key": "aHBhYy1zYWZldHktZGV2ZWxvcG1lbnQta2V5LW9ubHk="
    },
    "Media": {
      // Local disk instead of a real bucket, so a clean checkout runs with no
      // AWS credential. See issue #14. /tmp rather than a repo-relative path:
      // the API container runs as a non-root user with no write access under
      // its /app working directory, and /tmp is writable both there and on a
      // contributor's own machine running `dotnet run` directly.
      "Storage": {
        "FileSystem": {
          "RootPath": "/tmp/hpac-safety-dev-blobs"
        }
      }
    }
  },
  // A throwaway, Development-only convenience: verifying against the live
  // members site proves membership only, so these email lists name who gets
  // Administrator/SafetyOfficer for local testing. Never a production
  // concept. See ADR-0079.
  "MembersSiteLogin": {
    "AdministratorEmails": ["chase.florell@gmail.com", "bertrand.stoffel@gmail.com"],
    "SafetyOfficerEmails": []
  }
}
