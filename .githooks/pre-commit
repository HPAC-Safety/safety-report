#!/usr/bin/env sh
#
# Two independent checks, each gated on the kind of file actually staged so
# an unrelated commit pays nothing. This file is the tracked template;
# ./init-dev.sh copies it into the real hooks directory (see that file for
# why it's a copy rather than core.hooksPath) — edit this copy, not the
# installed one, and re-run ./init-dev.sh to pick up the change.
#
# 1. locales/en-CA.json and locales/fr-CA.json parity: a missing/extra key, a
#    local `#`-stub (tools/stub-missing-translations.mjs, ADR-0054) that must
#    never reach a PR, or stale fr-CA.meta.json provenance. Runs the exact
#    same checks as the "i18n" CI job (tools/check-locales.mjs,
#    tools/translate-locale.mjs --check) but locally, before the commit
#    exists, instead of after a push.
#
# 2. C# formatting: dotnet format --include <staged files>, auto-fixing and
#    re-staging just those files, so formatting drift never reaches a commit
#    without touching files outside the diff. CI's "build" job re-verifies
#    the whole solution with --verify-no-changes as a server-side backstop
#    for anyone who skipped this hook.

set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

if git diff --cached --name-only --diff-filter=ACMR | grep -q '^locales/'; then
	if ! command -v node >/dev/null 2>&1; then
		echo "pre-commit: node is not on PATH, cannot verify locales/ — see README.md" >&2
		exit 1
	fi

	node tools/check-locales.mjs
	node tools/translate-locale.mjs --check --locales locales
fi

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(cs|csproj)$'; then
	if ! command -v dotnet >/dev/null 2>&1; then
		echo "pre-commit: dotnet is not on PATH, cannot run dotnet format — see README.md" >&2
		exit 1
	fi

	STAGED_CS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(cs|csproj)$')

	# --include scopes formatting to the staged files, not the whole solution,
	# so a commit touching two files never rewrites (and re-stages) unrelated
	# ones elsewhere in the tree that also happen to be out of format.
	# shellcheck disable=SC2086 # word-split on purpose: one path per --include arg
	dotnet format HpacSafety.slnx --include $STAGED_CS

	echo "$STAGED_CS" | while IFS= read -r f; do
		[ -f "$f" ] && git add -- "$f"
	done
fi
