# npm 12 changed allow-remote's default from all to none. @tailwindcss/oxide's
# wasm32-wasi optional fallback declares bundleDependencies, which forces npm
# to download and unpack that tarball to re-resolve the tree even though it
# is never installed on any CI/dev platform here — npm 12 classifies that as
# a "remote" fetch and refuses it by default. This breaks Renovate's hosted
# runner (npm 12) regenerating this lockfile for ANY dependency bump, not
# just tailwindcss ones. `root` is not enough; the fetch is transitive.
# See https://github.com/renovatebot/renovate/issues/13810.
allow-remote=all
