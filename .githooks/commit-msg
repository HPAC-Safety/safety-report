#!/usr/bin/env sh
#
# Refuses a commit message that carries a coding agent's session link
# (ADR-0107). The repository is public, and a squash merge makes the
# pull-request body a commit message too; the "Linked issue" workflow checks
# that body, and this checks every commit before it exists. The agents whose
# links are refused are the collection in tools/github/check-agent-session-links.ts.
#
# This file is the tracked hook, run by the shim ./init-dev.sh installs
# (tools/dev/git-hook-shim.sh) — edit this file, not the installed one.

set -u

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 0

command -v node >/dev/null 2>&1 || exit 0

exec node tools/github/check-agent-session-links.ts "$1"
