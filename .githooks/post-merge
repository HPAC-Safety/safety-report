#!/usr/bin/env sh
#
# In a clone where ./init-dev.sh registered the `ours` driver, the generated
# .spec/claims.json, .spec/traceability.md, and .spec/README.md never stop a
# local merge or rebase — see .gitattributes (`merge=ours`) — but only because,
# when both sides changed one, git keeps whichever side happened to be checked
# out instead of merging them, which is not the tree that actually landed. This hook is the other half: once the
# merge has genuinely finished and every file (including the .feature files
# they are derived from) is on disk in its final state, regenerate them for
# real and stage the result, so the next commit carries the correct files
# instead of stale ones CI's "docs" job would otherwise have to catch. It then
# merges the specification into the local graphify graph (ADR-0193).
#
# A dev-machine convenience, not a CI gate (same framing as pre-commit). On a
# same-repo pull request .github/workflows/traceability.yml regenerates and
# commits them too, and CI re-checks the whole tree in the "docs" job
# (ADR-0101). This file is the tracked hook, run by the shim ./init-dev.sh
# installs (tools/dev/git-hook-shim.sh) — edit this file, not the installed one.
#
# The regenerate-and-stage step is shared with post-rewrite, in
# lib/regenerate-spec.sh; the skip on main below stays here (CONV-005).
# The agent-tooling install and prune, in lib/install-agent-tooling.sh, runs on
# main too.

set -u

HOOK_DIR=$(cd "$(dirname "$0")" && pwd) || exit 0
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 0

# shellcheck source=.githooks/lib/regenerate-spec.sh
. "$HOOK_DIR/lib/regenerate-spec.sh"
# shellcheck source=.githooks/lib/install-agent-tooling.sh
. "$HOOK_DIR/lib/install-agent-tooling.sh"

# .claude/agents and .claude/skills are gitignored, so this runs on main too: it
# installs what the Skillfile declares and prunes what it no longer does, and
# restores a Skillfile.lock the install rewrote when on main.
agent_tooling_changed && { install_agent_tooling post-merge || echo "post-merge: skillfile install failed — run it directly to see why"; }

# The primary checkout's main only ever fast-forwards to origin/main, which
# already carries the claims, matrix, and index CI regenerated and checked
# (ADR-0101). Nothing is regenerated or staged there: a hook must never leave a
# change on main (#802).
if [ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "main" ]; then
	merge_spec_graph
	exit 0
fi

regenerate_spec post-merge

exit 0
