root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
# Tabs over spaces — see ADR-0075. tab_width sets what a tab renders as,
# matching this repo's previous space widths so nothing shifts visually.
indent_style = tab
tab_width = 2

[*.{cs,csproj,props,targets}]
tab_width = 4

# YAML's indentation is significant and its spec forbids tabs outright; a
# tab here is a parse error, not a style choice.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Gherkin's parser rejects a tab in a feature file's indentation.
[*.feature]
indent_style = space
indent_size = 2

[*.cs]
# Conventions enforced once code lands — see docs/testing-conventions.md
dotnet_diagnostic.CA1062.severity = warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Block bodies for anything with a method-like signature; arrows stay for
# simple get-only properties/indexers, which `dotnet format` leaves alone.
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_local_functions = false:suggestion
# Always braced, even for a one-line body.
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

# Merge-friendly wrapping: a change to one element touches one line. These are
# ReSharper/Rider keys; `dotnet format` has no wrapping rules and ignores them.
#
#   public Thing(string foo,
#                string bar)
#   	: base(foo)
#   {
#
# A multiline list ends in a trailing comma; a single-line list never does.
resharper_csharp_trailing_comma_in_multiline_lists = true
resharper_csharp_trailing_comma_in_singleline_lists = false
# More than one declared parameter: one per line, the first on the `(` line and
# the rest aligned under it. A lone parameter stays on the signature line.
# optimal_fill (tabs, then spaces for the remainder) is what `dotnet format`
# rewrites alignment to under indent_style = tab, so the two tools agree.
resharper_csharp_wrap_parameters_style = chop_always
resharper_csharp_wrap_after_declaration_lpar = false
resharper_csharp_align_multiline_parameter = true
resharper_csharp_alignment_tab_fill_style = optimal_fill
# `: base(...)` and `: this(...)` always start their own line.
resharper_csharp_place_constructor_initializer_on_same_line = false
# A compound condition in if/while/do is chopped, operator leading each line.
resharper_csharp_wrap_before_binary_opsign = true
resharper_csharp_force_chop_compound_if_expression = true
resharper_csharp_force_chop_compound_while_expression = true
resharper_csharp_force_chop_compound_do_expression = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Test projects: Given_When_Then naming is the convention here, so the
# underscore rule does not apply. See docs/testing-conventions.md.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

# Banned symbols are an error, not a warning. TreatWarningsAsErrors would make
# it one anyway, but stating it means the rule survives someone relaxing that.
dotnet_diagnostic.RS0030.severity = error

# Scaffolded EF Core migrations. `dotnet ef` writes these; hand-editing them to
# satisfy an analyser would be undone by the next scaffold, and coverlet already
# treats them as generated code. The seed data they call into is ordinary code
# in Persistence/Seeding and is analysed and measured like everything else.
[**/Migrations/*.cs]
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1861.severity = none
# `dotnet ef` emits a block-scoped namespace and has no option to do otherwise.
dotnet_diagnostic.IDE0161.severity = none
