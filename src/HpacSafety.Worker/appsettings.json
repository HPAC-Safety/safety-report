{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    // Supplied per environment. Empty here so that nothing ever falls back to
    // a database somebody did not mean to write to.
    "HpacSafety": ""
  },
  "AiChatClient": {
    // The one summarization call's provider, key, model, and reasoning level,
    // kept together (ADR-0104). An unknown provider, a blank model, or a
    // reasoning level other than low/medium/high stops the Worker at startup
    // whenever a key is present.
    //
    // Which IAiChatClient strategy runs. "Gemini" is the only one today; a
    // future "Anthropic" or "OpenAI" is a new class plus one registration entry.
    "Provider": "Gemini",
    // A paid, billing-enabled key only — the free tier may use submitted
    // content. Never committed: supplied per environment as the environment
    // variable AiChatClient__ApiKey, from the GEMINI_API_KEY_PROD repository
    // secret in the deploy workflow, or exported as GEMINI_API_KEY for
    // docker-compose in development. With no key, summarization fails closed.
    "ApiKey": "",
    "Model": "gemini-3.7-flash",
    // low | medium | high. Low is enough: the marking pass replaces exact
    // private values before the call, and the prompt carries every
    // replacement rule. Raise it to medium if reviewers find paraphrased
    // identities getting through. The temperature is deliberately not set.
    "ReasoningEffort": "low"
  },
  "HpacSafety": {
    "FieldEncryption": {
      // Report values are encrypted by the application before PostgreSQL
      // sees them. The key is a base64 256-bit value, supplied per environment:
      // a throwaway literal in appsettings.Development.json, a Secrets Manager
      // reference in production. Never committed with a real value.
      // See ADR-0019.
      "Key": ""
    }
  }
}
