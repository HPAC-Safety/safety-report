<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" />
        <!-- The API's async nudge to the Worker's Lambda function (ADR-0123, #443). -->
        <PackageReference Include="AWSSDK.Lambda" />
        <!-- Reads the RDS-managed master-user secret at cold start (#443). -->
        <PackageReference Include="AWSSDK.SecretsManager" />
        <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HpacSafety.Core\HpacSafety.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Raw SQL lives in its own files and is loaded by SqlScript (ADR-0055). -->
        <EmbeddedResource Include="Persistence\Sql\*.sql" LogicalName="Sql/%(Filename)%(Extension)" />
        <!-- The one translation prompt and the term list, shared with CI's
             tools/i18n/translator.ts, which reads the same files (ADR-0179). -->
        <EmbeddedResource Include="..\..\locales\translation-prompt.v2.md" LogicalName="Translation/translation-prompt.v2.md" />
        <EmbeddedResource Include="..\..\locales\terms.json" LogicalName="Translation/terms.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <!-- IHttpClientFactory, for the translation provider. -->
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <!-- Design-time only: `dotnet ef` uses this project as both the migrations
             project and the startup project, through the IDesignTimeDbContextFactory
             in Persistence. It is never part of a deployed application. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
