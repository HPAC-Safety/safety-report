{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Translation": {
    // Machine translation between en-CA and fr-CA (ADR-0179). It uses the
    // AiChatClient key below, so there is no key here; only its own model and
    // reasoning level, tuned apart from summaries. The model name picks the
    // provider ("gemini-" is Gemini). A blank model or a level other than
    // low/medium/high stops startup, and so does a model no provider claims
    // when a key is held (REQ-WLD-040, REQ-WLD-043).
    "Model": "gemini-3.7-flash",
    "ReasoningEffort": "low"
  },
  "AiChatClient": {
    // The Gemini key, shared with the Worker's summary call (ADR-0104). The
    // API uses it only for translation (ADR-0179), whose own Translation:Model
    // picks the provider by its name; there is no provider setting. In every
    // deployed environment the key is read from Secrets Manager by the ARN
    // Terraform sets as AiChatClient__ApiKeySecretArn (infra/lambda.tf); locally
    // it is the plain AiChatClient__ApiKey environment variable, exported as
    // GEMINI_API_KEY for docker-compose. Never committed. With no key,
    // translation is unavailable. The summary model and reasoning level are the
    // Worker's, not set here.
    "ApiKey": ""
  },
  "ConnectionStrings": {
    // Supplied per environment. Empty here so that nothing ever falls back to
    // a database somebody did not mean to write to.
    "HpacSafety": ""
  },
  "HpacSafety": {
    "FieldEncryption": {
      // Report values are encrypted by the application before PostgreSQL
      // sees them. The key is a base64 256-bit value, supplied per environment:
      // a throwaway literal in appsettings.Development.json, a Secrets Manager
      // reference in production. Never committed with a real value.
      // See ADR-0019.
      "Key": ""
    },
    "Media": {
      // One size limit per kind, in bytes: 250 MB video, 25 MB image or
      // document (ADR-0126), and how many files one report may carry (#14).
      "Policy": {
        "MaxVideoByteSize": 262144000,
        "MaxImageByteSize": 26214400,
        "MaxDocumentByteSize": 26214400,
        "MaxAttachmentCount": 5
      },
      // The largest file a safety officer or administrator may add to a report
      // as a private attachment: 1 GB, of any type, separate from the reporter
      // caps above (ADR-0135).
      "PrivateAttachments": {
        "MaxByteSize": 1073741824
      },
      // The private bucket. Supplied per environment; empty here so nothing
      // ever falls back to a bucket nobody meant to write to. ServiceUrl stays
      // empty in AWS, where the SDK reaches S3 as the ECS task role; only
      // development points it at an S3-compatible container (ADR-0096).
      "Storage": {
        "S3": {
          "BucketName": "",
          "ServiceUrl": "",
          "PublicServiceUrl": ""
        }
      }
    },
    "RateLimiting": {
      // A burst allowance, not a hard cap on legitimate use: a reporter's one
      // report submission is one request; a member fixing a typo tries
      // sign-in more than once. See ADR-0081 and issue #15.
      "PublicSubmission": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      // Each attached file is one upload, and a cancel or remove is another
      // request, so one report legitimately makes a dozen or so. See ADR-0096.
      "AttachmentUpload": {
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      // Deliberately stricter: nobody legitimately attempts many different
      // sign-ins from one identity in a short window, and this endpoint
      // makes a real call to the live members site per attempt (ADR-0079).
      "SignIn": {
        "PermitLimit": 5,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    }
  }
}
