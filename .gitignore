# Written locally by `tools/stub-missing-translations.mjs` (predev/prebuild,
# ADR-0054) so untranslated keys are visible while developing. Real French is
# generated in CI only (ADR-0021) and reaches these paths by a normal merge
# from main, which this entry does not affect — see the ADR.
locales/fr-CA.json
locales/fr-CA.meta.json

# Installed and cached by `skillfile install` — reproduced from Skillfile.lock,
# never committed. See CONTRIBUTING.md.
.claude/skills/
.claude/agents/
.skillfile/cache/

# Written by `graphify claude install` — machine-local (hardcodes an absolute
# path to the graphify binary), never committed.
.claude/settings.json

# Secrets and local config
.env
.env.local
appsettings.Development.local.json

# OS
.DS_Store
Thumbs.db

# Graphify tooling and output are clone-local.
/graphify-out/
/.graphify-tool/
/.graphify-version
/.graphify-agent
/.gitattributes

# Agent-created git worktrees are clone-local, not repo content.
/.claude/worktrees/
