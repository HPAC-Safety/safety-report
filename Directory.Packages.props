<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>
	<!-- Each ItemGroup in this file should be sorted alphabetically based on their Label -->
	<!-- Each PackageVersion within each ItemGroup should be sorted alphabetically based on their Include-->
	<!-- Renovate groups its update PRs on these same boundaries, see renovate.json -->
	<ItemGroup Label="Analyzers">
		<!-- Enforces tests/BannedSymbols.txt, which is how the Shouldly rule stops
		     being documentation and starts being a build error. See ADR-0013. -->
		<PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
		<PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
	</ItemGroup>
	<ItemGroup Label="AWSSDK">
		<!-- S3 only, and only in Infrastructure. Uploads go straight from the
		     browser to a private bucket through a pre-signed PUT, so the SDK never
		     appears in Core. See ADR-0026. -->
		<PackageVersion Include="AWSSDK.S3" Version="4.0.104.1" />
		<!-- The API's async nudge to the Worker's Lambda function after a commit
		     that queues outbox work (ADR-0123, #443). Infrastructure only. -->
		<PackageVersion Include="AWSSDK.Lambda" Version="4.0.108.2" />
		<!-- Reads the RDS-managed master-user secret at cold start, to assemble
		     the connection string without ever putting the password in
		     Terraform state (#443, coordinated with #465). Infrastructure only. -->
		<PackageVersion Include="AWSSDK.SecretsManager" Version="4.0.100.15" />
	</ItemGroup>
	<ItemGroup Label="AWSLambda">
		<!-- The Worker's own Lambda entry point (ADR-0042, ADR-0123, #443): one
		     drain-once invocation, not the ASP.NET Core Lambda Web Adapter the API
		     uses. Worker only. -->
		<PackageVersion Include="Amazon.Lambda.Core" Version="3.3.0" />
		<PackageVersion Include="Amazon.Lambda.RuntimeSupport" Version="2.2.3" />
	</ItemGroup>
	<ItemGroup Label="Coverage">
		<!-- ReportGenerator is the other half of this and lives in
		     .config/dotnet-tools.json, since it is a tool rather than a
		     reference. Renovate groups the two together. See ADR-0014. -->
		<PackageVersion Include="coverlet.collector" Version="10.1.0" />
	</ItemGroup>
	<ItemGroup Label="EntityFrameworkCore">
		<!-- EF Core and the Npgsql PROVIDER move together or migrations break, so
		     they share one group here and one group in renovate.json. The bare
		     Npgsql driver is a different vendor on its own cadence and stays in
		     its own group below. -->
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
		<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
	</ItemGroup>
	<ItemGroup Label="libphonenumber">
		<!-- Validates a phone answer for its country at submission, with the same
		     Google metadata the form's libphonenumber-js uses. API only; Core
		     checks just the E.164 shape. See ADR-0137. -->
		<PackageVersion Include="libphonenumber-csharp" Version="9.0.41" />
	</ItemGroup>
	<ItemGroup Label="Magick.NET">
		<!-- EXIF stripping and content-type sniffing for uploaded media. Apache-2.0
		     with no revenue threshold, and it strips metadata rather than
		     re-encoding a decoded bitmap. See ADR-0025. -->
		<PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
	</ItemGroup>
	<ItemGroup Label="Microsoft and System">
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<!-- FakeLogger. The Worker tests need the log. -->
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
		<!-- FakeTimeProvider. The outbox poll-loop tests in #17 need the clock. -->
		<PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
	</ItemGroup>
	<ItemGroup Label="Npgsql">
		<!-- The bare driver only, used by the Testcontainers harness to prove a
		     container is reachable. Npgsql.EntityFrameworkCore.PostgreSQL arrives
		     with the DbContext and lives in the EntityFrameworkCore group above -
		     the provider is pinned to EF Core's cadence, this is not. Renovate
		     groups them the same way. -->
		<PackageVersion Include="Npgsql" Version="10.0.3" />
	</ItemGroup>
	<ItemGroup Label="Reqnroll">
		<!-- Executes the Gherkin scenarios under .spec/features/ as xUnit v3 tests.
		     See ADR-0198. Reqnroll.Tools.MsBuild.Generation is the actual
		     feature-file-to-code-behind compiler; Reqnroll.xUnit.v3 only wires the
		     generated tests into xUnit v3. -->
		<PackageVersion Include="Reqnroll.Tools.MsBuild.Generation" Version="3.3.4" />
		<PackageVersion Include="Reqnroll.xUnit.v3" Version="3.3.4" />
	</ItemGroup>
	<ItemGroup Label="Shouldly">
		<!-- The assertion library for this repository. Not Assert.*, not FluentAssertions. -->
		<PackageVersion Include="Shouldly" Version="4.3.0" />
	</ItemGroup>
	<ItemGroup Label="Testcontainers">
		<PackageVersion Include="Testcontainers" Version="4.16.0" />
		<PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
	</ItemGroup>
	<ItemGroup Label="xunit">
		<!-- xunit.v3.mtp-off keeps `dotnet test` on VSTest, so coverlet, the trx
		     logger and tools/coverage/report-test-counts.ts stay as they are. -->
		<PackageVersion Include="xunit.v3.mtp-off" Version="4.0.1" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
	</ItemGroup>
	<!--
		Families expected as the system is built, listed here so they land in the
		right group rather than at the bottom of the file:

			Anthropic                       the SDK used by the worker
			AWSSDK                          SimpleEmail
			FakeItEasy                      test doubles
			Microsoft and System            Localization
	-->
</Project>
