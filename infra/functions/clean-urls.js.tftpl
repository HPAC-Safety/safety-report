// CloudFront Function, viewer-request event.
//
// A Terraform template: ADMIN_PREFIX below is substituted from
// var.admin_path_prefix, which also drives the cache behavior and the response
// headers policy in cdn.tf. Defining the prefix once is the point — three copies
// of "/admin" is two copies that will drift.
//
// The site needs clean URLs served at 200 — /report, not /report.html and not a
// 301 to it. A viewer-request function rewrites the URI before CloudFront looks
// in the origin, so there is no round trip and no redirect. This is the
// mechanism ADR-0009 names; deploy-web.yml only ships content and never touches
// it.
//
// One site, two areas (ADR-0031):
//
//   /                -> /index.html          the public report form
//   /report          -> /report.html
//   /admin           -> /admin/index.html    the review queue
//   /admin/queue     -> /admin/queue.html
//   /styles/site.css -> unchanged
//
// This function performs NO authorization. It cannot: it runs before CloudFront
// has an origin response and has no way to check a session. The admin bundle is
// static HTML and JavaScript that holds no report data, and the boundary that
// matters is the API's authorization (#24). Do not add an access check here and
// believe the review queue is protected.
//
// CloudFront Functions run a constrained JavaScript runtime: no template
// literals, a 1 ms budget, and an ES surface that is documented rather than
// assumed. Keep it boring.

var ADMIN_PREFIX = '${admin_prefix}';

function handler(event) {
    var request = event.request;
    var uri = request.uri;

    // "/" and "/admin/" -> the directory index. charAt rather than endsWith:
    // the CloudFront Functions runtime is not a browser.
    if (uri.charAt(uri.length - 1) === '/') {
        request.uri = uri + 'index.html';
        return request;
    }

    // "/admin" is a directory, not a page. Rewritten, not redirected, so the
    // address bar keeps the clean URL.
    if (uri === ADMIN_PREFIX) {
        request.uri = ADMIN_PREFIX + '/index.html';
        return request;
    }

    // Anything with a file extension is a real asset: stylesheet, script,
    // locale JSON, image. Leave it alone.
    var lastSegment = uri.substring(uri.lastIndexOf('/') + 1);
    if (lastSegment.indexOf('.') !== -1) {
        return request;
    }

    // "/report" -> "/report.html", "/admin/queue" -> "/admin/queue.html".
    request.uri = uri + '.html';
    return request;
}
