# Build output
bin/
obj/
*.user
*.suo
artifacts/
TestResults/
coverage/
*.coverage
*.cobertura.xml

# Local FileSystemBlobStore root (Development media storage stand-in)
.local/

# Editor/IDE
.idea/

# Node
node_modules/
.playwright/
playwright-report/
test-results/
src/web/dist/
tests/e2e/.features-gen/


# Installed and cached by `skillfile install` — reproduced from Skillfile.lock,
# never committed. See CONTRIBUTING.md.
.claude/skills/
.claude/agents/
.skillfile/cache/

# .claude/settings.json is tracked (team-wide hooks, PATH-based, nothing
# machine- or person-specific — see CONTRIBUTING.md). Personal overrides go
# in .claude/settings.local.json instead, which stays untracked.
.claude/settings.local.json

# Secrets and local config
.env
.env.local
# act's default secret, variable, and personal-flag files. .actrc points act
# at /dev/null for the first two; tools/ci-local.sh gives act no token
# (ADR-0145).
.secrets
.vars
.actrc.local
# main's coverage baseline, which tools/ci-local.sh downloads on the host into
# the clone act copies (ADR-0145).
/.ci-local/
appsettings.Development.local.json

# OS
.DS_Store
Thumbs.db

# Graphify tooling and output are clone-local.
/graphify-out/
# Written by `./init-dev.sh --obsidian` from the graph — regenerated, never committed.
/obsidian-vault/
/.graphify-tool/
/.graphify-version
/.graphify-agent
/.gitattributes

# Agent-created git worktrees are clone-local, not repo content.
/.claude/worktrees/
