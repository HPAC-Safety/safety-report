#!/usr/bin/env sh
#
# .spec/traceability.md never conflicts during a merge or rebase — see
# .gitattributes (`merge=ours`) and init-dev.sh for why — but "never
# conflicts" only works because it also never gets git's own content merge,
# so the file left behind is whichever side happened to be checked out, not
# the tree that actually landed. This hook is the other half: once the merge
# has genuinely finished and every file (including the .feature files the
# matrix is derived from) is on disk in its final state, regenerate it for
# real and stage the result, so the next commit carries the correct matrix
# instead of a stale one CI's "docs" job would otherwise have to catch.
#
# A dev-machine convenience, not a CI gate (same framing as pre-commit). On a
# same-repo pull request .github/workflows/traceability.yml regenerates and
# commits the matrix too, and CI re-checks the whole tree in the "docs" job
# (ADR-0101). This file is the tracked hook, run by the shim ./init-dev.sh
# installs (tools/dev/git-hook-shim.sh) — edit this file, not the installed one.

set -u

# The primary checkout's main only ever fast-forwards to origin/main, which
# already carries the matrix, index, and bindings CI regenerated and checked
# (ADR-0101). Nothing is regenerated or staged there: a hook must never leave a
# change on main (#802).
[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "main" ] && exit 0

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 0

command -v node >/dev/null 2>&1 || exit 0

# The matrix, the specification index, and the step-bindings map are
# generated from .spec/ and the step definitions (ADR-0084, ADR-0183, ADR-0184).
node tools/spec/generate-traceability.ts >/dev/null 2>&1 || exit 0
node tools/spec/generate-spec-index.ts >/dev/null 2>&1 || exit 0
node tools/spec/generate-bindings.ts --no-fail >/dev/null 2>&1 || exit 0

for generated in .spec/traceability.md .spec/README.md .spec/bindings.md; do
	if ! git diff --quiet -- "$generated"; then
		git add -- "$generated"
		echo "post-merge: $generated regenerated and staged — include it in your next commit."
	fi
done

exit 0
